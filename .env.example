# --- Supabase (projeto exclusivo da RB) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Chave publicável (sb_publishable_...) ou anon legada. Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (sb_secret_...) ou service_role. SOMENTE no servidor (Vercel).
# Necessária para: chatbot, notificações por e-mail e webhooks de leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rbassessoria.com.br
# Segredo para hash de IP (rate limit/LGPD). Gere com: openssl rand -hex 32
IP_HASH_SALT=

# --- IA do chatbot (preencha só o provedor escolhido no painel) --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- E-mail de notificação (opcional) -----------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=RB Assessoria <notificacoes@seu-dominio.com.br>

# --- Webhook de leads externos (ManyChat etc.) ---------------------------
# Token exigido no header Authorization: Bearer <token>. openssl rand -hex 32
LEADS_WEBHOOK_TOKEN=

# --- Tarefas agendadas (Vercel Cron) ------------------------------------
CRON_SECRET=

# --- E-mail marketing (Resend) -------------------------------------------
# RESEND_API_KEY (acima) + ID do segmento que recebe os leads com consentimento
RESEND_SEGMENT_ID=

# --- Meta Ads (somente leitura de resultados) — ver docs/META-ADS.md ------
META_AD_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
